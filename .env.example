# Supabase API 설정
# 아래에 자신의 Supabase 프로젝트 정보를 입력하세요.
# https://supabase.com 에서 Settings > API에서 확인할 수 있습니다.

# Supabase 프로젝트 URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 익명 공개 키 (anon/public)
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 참고: 프로덕션 환경에서는 환경변수를 서버에서만 관리하세요.
# 클라이언트 환경변수에 민감한 정보를 노출하지 마십시오.
