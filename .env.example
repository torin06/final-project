# Supabase API 설정 (Vercel 환경변수)
# 아래 정보를 Vercel 프로젝트 Settings > Environment Variables에서 설정하세요.
# https://supabase.com 에서 Settings > API에서 확인할 수 있습니다.

# Supabase 프로젝트 URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 익명 공개 키 (anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ℹ️ 로컬 개발 환경에서는 프로젝트 루트에 .env 파일을 만들어 위 값을 입력하세요.
# Vercel 배포 시에는 Vercel 대시보드에서 Environment Variables로 설정합니다.

